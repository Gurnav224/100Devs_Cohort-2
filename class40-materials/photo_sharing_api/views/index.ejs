<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Photo Sharing Application</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col items-center justify-start p-6 space-y-6">

  <h1 class="text-3xl font-bold text-gray-800 mb-4">📷 Photo Sharing Application</h1>

  <form action="/" method="post" class="w-full max-w-md bg-white p-6 rounded-xl shadow space-y-4">
    <div>
      <label for="image_url" class="block text-gray-700 font-medium mb-1">Image URL</label>
      <input type="text" name="image_url" id="image_url"
        class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
    </div>
    <div>
      <label for="caption" class="block text-gray-700 font-medium mb-1">Caption</label>
      <input type="text" name="caption" id="caption"
        class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
    </div>
    <button type="submit"
      class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition">Submit</button>
  </form>

<div class="w-full max-w-6xl grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
  <% photos.forEach(function(item, index) { %>
    <div class="bg-white p-4 rounded-lg shadow-md flex flex-col items-start gap-2">
      <img id="img-<%= index %>" src="<%= item.image_url %>" alt="<%= item.caption %>" class="w-full rounded-md border object-fit-contain" />
      <p class="text-gray-700">📄 <strong>Caption:</strong> <%= item.caption %></p>
     <div class="flex items-center justify-center gap-6">
         <a href="photos/<%= item._id %>" class="text-blue-600 hover:underline">View Details</a>
      <button id="copy_btn_<%= index %>" data-index="<%= index %>" class="mt-2 bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded">
        Copy Image URL
      </button>
     </div>
    </div>
  <% }); %>
</div>


  <script>
    document.querySelectorAll('button[id^="copy_btn_"]').forEach((btn) => {
      btn.addEventListener('click', async function () {
        const index = btn.dataset.index;
        const imageSrc = document.getElementById(`img-${index}`).src;
        try {
          await navigator.clipboard.writeText(imageSrc);
          alert('Image URL copied to clipboard!');
        } catch (err) {
          console.error('Failed to copy:', err);
          alert('Failed to copy image URL.');
        }
      });
    });
  </script>

</body>

</html>
